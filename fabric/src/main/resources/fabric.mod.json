{
  "schemaVersion": 1,
  "id": "furniture",
  "version": "${version}",
  "name": "[Let's Do] Furniture",
  "description": "Furnish your world with chairs, sofas, clocks, lamps, fish tanks, telescopes and much more, all in the cozy Let's Do style.",
  "authors": [
    "satisfy"
  ],
  "contributors": [
    "berksire",
    "cph101dev",
    "MissLilitu"
  ],
  "contact": {
    "homepage": "https://www.lets-do.ch",
    "wiki": "https://lets-do.ch/wiki/furniture/",
    "sources": "https://github.com/Let-s-Do-Collection/Furniture",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.furniture.fabric.FurnitureFabric"
    ],
    "client": [
      "net.satisfy.furniture.fabric.client.FurnitureClientFabric"
    ],
    "modmenu": [
      "net.satisfy.furniture.fabric.config.ModMenu"
    ]
  },
  "mixins": [
    "furniture-common.mixins.json",
    "furniture-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "architectury": ">=13.0.8",
    "foundation": ">=1.0.7",
    "cloth-config": "*"
  }
}
